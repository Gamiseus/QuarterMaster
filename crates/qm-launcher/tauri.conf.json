{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuarterMaster",
  "version": "1.2.0",
  "identifier": "com.quartermaster.launcher",
  "build": {
    "frontendDist": "../../launcher-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../launcher-ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../launcher-ui" }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuarterMaster",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
