  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "check": "svelte-check --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
